<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fundo_caixa_texto" />
            <stroke android:width="2dp" android:color="@color/glpi_blue" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fundo_caixa_texto" />
            <stroke android:width="1dp" android:color="@color/linha_separadora" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>