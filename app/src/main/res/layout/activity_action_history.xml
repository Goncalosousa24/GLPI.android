<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    tools:context=".ActionHistoryActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_history_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="110dp"
                android:paddingBottom="16dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_loading_history"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="50dp"
                    android:visibility="gone"
                    app:lottie_rawRes="@raw/carregar"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_action_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:nestedScrollingEnabled="false"
                    android:layoutAnimation="@anim/layout_animation_slide_up" />

                <!-- Paginação (Estilo Padrão) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pagination_history"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_pagina_anterior_history"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_proxima_pagina_history">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_voltar_history_pag"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleX="-1"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:lottie_colorFilter="@color/azul_glpi"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_proxima_pagina_history"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="100dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_goneMarginStart="0dp"
                        app:layout_constraintStart_toEndOf="@+id/btn_pagina_anterior_history"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_avancar_history_pag"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:lottie_colorFilter="@color/azul_glpi"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_empty_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="50dp"
                    android:text="Sem ações recentes para mostrar."
                    android:textColor="@color/texto_dica"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_arredondado"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/header_layout"
        android:layout_marginBottom="-16dp" />

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btn_voltar_history"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_seta_history"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/esquerda"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_titulo_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/amiko_bold"
            android:gravity="center"
            android:text="HISTÓRICO DA CONTA"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <!-- Espaçador invisível para equilibrar a seta e centrar o título -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
