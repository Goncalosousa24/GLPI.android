<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_arredondado">

    <ImageView
        android:id="@+id/iv_close_filter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/azul_glpi" />

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="FILTRAR PARA RESOLVER"
        android:textColor="@color/texto_principal"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_close_filter" />

    <RadioGroup
        android:id="@+id/rg_assigned_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title">

        <LinearLayout
            android:id="@+id/ll_filter_geral"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Geral (Todos)"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_geral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_filter_abertos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Abertos (Novos)"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_abertos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_filter_progresso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Em Progresso"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_progresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_filter_prioritarios"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prioritários"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_prioritarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_filter_meus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meus (Em Resolução)"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_meus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_filter_atribuidos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atribuídos a mim"
                android:textAllCaps="true"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/texto_principal" />
            <RadioButton
                android:id="@+id/rb_filter_atribuidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul_glpi"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
