<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app">
 
    <View
        android:id="@+id/header_bg_report"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_arredondado"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/header_layout_report"
        android:layout_marginBottom="-16dp" />
 
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_report"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">
 
        <FrameLayout
            android:id="@+id/btn_voltar_report"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
 
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_seta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/esquerda"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>
 
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiko_bold"
            android:text="REPORTAR PROBLEMA"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
 
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_bg_report"
        app:layout_constraintBottom_toTopOf="@id/container_btn_enviar">
 
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="100dp">
 
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Número de Série" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:hintEnabled="false" app:boxBackgroundColor="@color/fundo_caixa_texto"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco" app:boxStrokeWidthFocused="2dp">
                <AutoCompleteTextView
                    android:id="@+id/auto_serial_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Digite ou selecione o SN" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:popupBackground="@color/fundo_app"
                    android:dropDownHeight="250dp" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Categoria" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:hintEnabled="false" app:boxBackgroundColor="@color/fundo_caixa_texto"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco" app:boxStrokeWidthFocused="2dp">
                <AutoCompleteTextView
                    android:id="@+id/auto_tipo_equipamento"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Selecione o tipo de dispositivo" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:popupBackground="@color/fundo_app"
                    android:dropDownHeight="250dp" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Onde está o equipamento?" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:hintEnabled="false" app:boxBackgroundColor="@color/fundo_caixa_texto"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco" app:boxStrokeWidthFocused="2dp">
                <AutoCompleteTextView
                    android:id="@+id/auto_localizacao"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Digite ou selecione a localização" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:popupBackground="@color/fundo_app"
                    android:dropDownHeight="250dp" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Qual é o motivo do problema?" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:hintEnabled="false" app:boxBackgroundColor="@color/fundo_caixa_texto"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco" app:boxStrokeWidthFocused="2dp">
                <AutoCompleteTextView
                    android:id="@+id/auto_motivo_problema"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="O que aconteceu com o aparelho?" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:popupBackground="@color/fundo_app"
                    android:dropDownHeight="250dp" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:layout_marginTop="8dp" android:layout_marginStart="12dp" 
                android:text="Descrição Detalhada" android:textColor="@color/texto_secundario" 
                android:textStyle="bold" android:textSize="12sp" 
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <EditText
                android:id="@+id/et_problem_description"
                android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_caixa_texto" android:backgroundTint="@null"
                android:gravity="top" android:hint="Explique detalhadamente o problema..." android:padding="16dp"
                android:textColor="@color/texto_principal" android:textColorHint="@color/texto_dica" android:textSize="14sp" />
 
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
 
    <FrameLayout
        android:id="@+id/container_btn_enviar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_report"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_botao_azul_gradiente"
            android:text="SUBMETER TICKET"
            android:textColor="@color/white"
            android:fontFamily="@font/amiko_bold"
            android:textStyle="bold" />
    </FrameLayout>
 
</androidx.constraintlayout.widget.ConstraintLayout>