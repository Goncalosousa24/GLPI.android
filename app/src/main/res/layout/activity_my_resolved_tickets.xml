<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    tools:context=".MyResolvedTicketsActivity">

    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_arredondado"
        android:layout_marginBottom="-16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/header_layout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_seta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/esquerda"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/search_and_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header_bg">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar_focused"
            android:addStatesFromChildren="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_lupa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                app:lottie_rawRes="@raw/pesquisa"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />

            <EditText
                android:id="@+id/search_bar_tickets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Pesquisar no histórico..."
                android:textColorHint="@color/texto_dica"
                android:paddingStart="52dp"
                android:paddingEnd="16dp"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:inputType="text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_ordem"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cartao_brilhante"
            android:clickable="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_ordem"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/sort"
                app:lottie_autoPlay="false"
                app:lottie_loop="false" />
        </FrameLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_and_filter_layout">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_resolved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_my_resolved_tickets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="10dp"
                    android:nestedScrollingEnabled="false"
                    android:layoutAnimation="@anim/layout_animation_slide_up"
                    tools:listitem="@layout/item_ticket" />

                <!-- Paginação (Estilo Padrão) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pagination_resolved"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_pagina_anterior_resolved"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_proxima_pagina_resolved">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_voltar_resolved"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleX="-1"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:lottie_colorFilter="@color/azul_glpi"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_proxima_pagina_resolved"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="100dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_goneMarginStart="0dp"
                        app:layout_constraintStart_toEndOf="@+id/btn_pagina_anterior_resolved"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_avancar_resolved"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:lottie_colorFilter="@color/azul_glpi"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_lista_vazia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="50dp"
                    android:text="Ainda não resolveste nenhum ticket."
                    android:textColor="@color/texto_dica"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loading"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_and_filter_layout"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/carregar" />

</androidx.constraintlayout.widget.ConstraintLayout>