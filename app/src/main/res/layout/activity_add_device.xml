<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout_add"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">
 
    <View
        android:id="@+id/header_bg_add"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_arredondado"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/header_layout_add"
        android:layout_marginBottom="-16dp" />
 
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_add"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">
 
        <FrameLayout
            android:id="@+id/btn_voltar_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
 
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_seta_add"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/esquerda"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>
 
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiko_bold"
            android:text="ADICIONAR EQUIPAMENTO"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
 
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_add"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_bg_add"
        app:layout_constraintBottom_toTopOf="@id/container_btn_adicionar">
 
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="300dp">
 
            <!-- TIPO DE DISPOSITIVO -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Tipo de Dispositivo" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_tipo_add"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="true" app:errorTextAppearance="@style/GLPI_ErrorText">
                <AutoCompleteTextView
                    android:id="@+id/auto_tipo_add"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:hint="Selecione o tipo" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:inputType="none" android:popupBackground="@color/cor_fundo_input"
                    android:dropDownHeight="wrap_content"
                    android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <!-- NOME -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Nome do Dispositivo" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nome_add"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="false"
                app:errorTextAppearance="@style/GLPI_ErrorText">
                <EditText android:id="@+id/et_nome_add" android:layout_width="match_parent" android:layout_height="60dp" android:hint="Ex: PC-SALA-01" android:paddingStart="16dp" android:textColor="@color/texto_principal" android:textSize="14sp" android:inputType="textCapCharacters" android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <!-- LOCALIZAÇÃO -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Localização" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="true" app:errorTextAppearance="@style/GLPI_ErrorText">
                <AutoCompleteTextView
                    android:id="@+id/auto_localizacao_add"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:hint="Pesquisar ou selecionar localização" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:inputType="text" android:popupBackground="@color/cor_fundo_input"
                    android:dropDownHeight="250dp"
                    android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <!-- TÉCNICO RESPONSÁVEL -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Técnico Responsável" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="true" app:errorTextAppearance="@style/GLPI_ErrorText">
                <AutoCompleteTextView
                    android:id="@+id/auto_tecnico_add"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:hint="Selecione o técnico" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:inputType="text" android:popupBackground="@color/cor_fundo_input"
                    android:dropDownHeight="250dp"
                    android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <!-- ESTADO -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Estado" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="true" app:errorTextAppearance="@style/GLPI_ErrorText">
                <AutoCompleteTextView
                    android:id="@+id/auto_estado_add"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:hint="Selecione o estado" android:paddingStart="16dp"
                    android:textColor="@color/texto_principal" android:textSize="14sp"
                    android:inputType="none" android:popupBackground="@color/cor_fundo_input"
                    android:dropDownHeight="wrap_content"
                    android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
            <!-- NÚMERO DE SÉRIE (S/N) -->
            <TextView 
                android:layout_width="wrap_content" android:layout_height="wrap_content" 
                android:text="Número de Série (S/N)" android:textSize="12sp" 
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp" 
                android:textColor="@color/texto_secundario" android:textStyle="bold"
                android:fontFamily="@font/amiko_bold" android:textAllCaps="true" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_sn_add"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/cor_fundo_input"
                app:boxCornerRadiusTopStart="25dp" app:boxCornerRadiusTopEnd="25dp" app:boxCornerRadiusBottomStart="25dp" app:boxCornerRadiusBottomEnd="25dp"
                app:boxStrokeColor="@color/seletor_borda_foco"
                app:boxStrokeWidthFocused="2dp"
                app:errorEnabled="false"
                app:errorTextAppearance="@style/GLPI_ErrorText">
                <EditText android:id="@+id/et_sn_add" android:layout_width="match_parent" android:layout_height="60dp" android:hint="Digite o número de série" android:paddingStart="16dp" android:textColor="@color/texto_principal" android:textSize="14sp" android:gravity="center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
 
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
 
    <!-- Overlay de Carregamento -->
    <FrameLayout
        android:id="@+id/loading_overlay_add"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/azul_glpi" />
    </FrameLayout>
 
    <FrameLayout
        android:id="@+id/container_btn_adicionar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_device"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_botao_azul_gradiente"
            android:text="ADICIONAR AO INVENTÁRIO"
            android:textColor="@color/white"
            android:fontFamily="@font/amiko_bold"
            android:textStyle="bold" />
    </FrameLayout>

    <include
        layout="@layout/layout_custom_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
 
</androidx.constraintlayout.widget.ConstraintLayout>