<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cartao_brilhante"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONFIGURAR SERVIDOR"
        android:textColor="@color/texto_principal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Insira o URL ou IP do seu servidor GLPI local:"
        android:textColor="@color/texto_principal"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_caixa_texto_branca"
        android:hint="http://192.168.1.100:8080/"
        android:textColorHint="@color/texto_dica"
        android:textColor="@color/texto_principal"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:fontFamily="@font/amiko_bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancelar_config"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_botao_opcao"
            android:text="CANCELAR"
            android:textColor="@color/texto_principal"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_guardar_config"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_botao_azul"
            android:text="GUARDAR"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</LinearLayout>
