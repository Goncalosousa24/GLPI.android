<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    tools:context=".PriorityTicketsActivity">

    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_arredondado"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/header_layout"
        android:layout_marginBottom="-16dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_seta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/esquerda"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiko_bold"
            android:text="TICKETS PRIORITÁRIOS"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/search_filter_row_priority"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header_bg">

        <FrameLayout
            android:id="@+id/search_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar_focused"
            android:addStatesFromChildren="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_lupa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                app:lottie_rawRes="@raw/pesquisa"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                app:lottie_colorFilter="@color/azul_glpi" />

            <EditText
                android:id="@+id/search_bar_priority"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Pesquisar urgências..."
                android:textColorHint="@color/texto_dica"
                android:paddingStart="52dp"
                android:paddingEnd="16dp"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:maxLines="1"
                android:inputType="text" />
        </FrameLayout>

        <!-- Botão de Filtro -->
        <FrameLayout
            android:id="@+id/btn_filtro_priority"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cartao_brilhante"
            android:clickable="true"
            android:focusable="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_filtro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/filtro"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>

        <!-- Botão de Ordem -->
        <FrameLayout
            android:id="@+id/btn_ordem_priority"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cartao_brilhante"
            android:clickable="true"
            android:focusable="true">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_ordem_priority"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/sort"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_colorFilter="@color/azul_glpi" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_priority"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_filter_row_priority">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tickets_priority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:paddingBottom="10dp"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/layout_animation_slide_up"
                tools:listitem="@layout/item_ticket" />

            <!-- Paginação (Estilo Padrão) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pagination_priority"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_pagina_anterior_priority"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_cartao_brilhante"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_proxima_pagina_priority">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_seta_voltar_priority"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleX="-1"
                        app:lottie_rawRes="@raw/seta_direita"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"
                        app:lottie_colorFilter="@color/azul_glpi"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_proxima_pagina_priority"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="100dp"
                    android:background="@drawable/bg_cartao_brilhante"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_goneMarginStart="0dp"
                    app:layout_constraintStart_toEndOf="@+id/btn_pagina_anterior_priority"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_seta_avancar_priority"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:lottie_rawRes="@raw/seta_direita"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"
                        app:lottie_colorFilter="@color/azul_glpi"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_lista_vazia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="50dp"
                android:text="Nenhuma urgência encontrada."
                android:textColor="@color/texto_dica"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>