<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo_app"
        tools:context=".LogsActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/header_bg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_header_arredondado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/header_layout"
                android:layout_marginBottom="-16dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/btn_voltar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_seta"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/esquerda"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_bold"
                    android:text="ALTERAR ESTADO"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/search_row"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/header_bg">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar_focused"
                    android:addStatesFromChildren="true">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_lupa"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        app:lottie_rawRes="@raw/pesquisa"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                    <EditText
                        android:id="@+id/search_bar_logs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Pesquisar nome ou S/N..."
                        android:textColorHint="@color/texto_dica"
                        android:paddingStart="52dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:inputType="text" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_ordem"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_cartao_brilhante"
                    android:clickable="true"
                    android:focusable="true">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_ordem"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/filtro"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                </FrameLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scroll_filtros"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"
                android:fillViewport="true"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/search_row">

                <LinearLayout
                    android:id="@+id/container_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_todos"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/selector_chip_filtros"
                        android:textColor="@color/selector_texto_chip"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="TODOS"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_computadores"
                        android:layout_width="110dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/selector_chip_filtros"
                        android:textColor="@color/selector_texto_chip"
                        android:gravity="center"
                        android:text="COMPUTADORES"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_monitores"
                        android:layout_width="110dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/selector_chip_filtros"
                        android:textColor="@color/selector_texto_chip"
                        android:gravity="center"
                        android:text="MONITORES"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Space
                        android:id="@+id/espaco_flexivel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/btn_expandir_categorias"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_botao_mais_azul"
                        android:clickable="true"
                        android:focusable="true">

                        <ViewSwitcher
                            android:id="@+id/symbol_switcher"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:inAnimation="@android:anim/fade_in"
                            android:outAnimation="@android:anim/fade_out">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/plus_animation"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                app:lottie_rawRes="@raw/plus"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:lottie_colorFilter="@android:color/white" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/minus_animation"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="4dp"
                                app:lottie_rawRes="@raw/minus"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:lottie_colorFilter="@android:color/white" />
                        </ViewSwitcher>
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nested_scroll_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/scroll_filtros"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_activity_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingBottom="24dp"
                        android:layoutAnimation="@anim/layout_animation_slide_up" />

                    <!-- Paginação (Estilo Padrão) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/container_paginacao_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="120dp"
                        android:visibility="gone">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_pagina_anterior"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_proxima_pagina">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_voltar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:scaleX="-1"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_proxima_pagina"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="100dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_goneMarginStart="0dp"
                            app:layout_constraintStart_toEndOf="@+id/btn_pagina_anterior"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_avancar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/tv_lista_vazia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum equipamento encontrado."
                android:textColor="@color/texto_dica"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scroll_filtros" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include 
        layout="@layout/layout_custom_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp" />

</FrameLayout>