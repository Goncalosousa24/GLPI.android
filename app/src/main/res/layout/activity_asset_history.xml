<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/header_bg_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_header_arredondado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header_layout"
            android:layout_marginBottom="-16dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/btn_voltar_history"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_seta_history"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/esquerda"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiko_bold"
                android:text="HISTÓRICO DE DISPOSITIVOS"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/search_container_history"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_search_bar_focused"
            android:addStatesFromChildren="true"
            app:layout_constraintTop_toBottomOf="@id/header_bg_history">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_lupa_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/pesquisa" />

            <EditText
                android:id="@+id/search_bar_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Pesquisar equipamento..."
                android:textColorHint="@color/texto_dica"
                android:paddingStart="52dp"
                android:paddingEnd="16dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/search_container_history"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="24dp"
                    android:layoutAnimation="@anim/layout_animation_slide_up" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pagination_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_prev_history"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_next_history">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/seta_prev_history"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleX="-1"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_next_history"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="100dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        app:layout_goneMarginStart="0dp"
                        app:layout_constraintStart_toEndOf="@+id/btn_prev_history"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/seta_next_history"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/progress_history_list"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:visibility="gone"
            app:lottie_rawRes="@raw/carregar"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
