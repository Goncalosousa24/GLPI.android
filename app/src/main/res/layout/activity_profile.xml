<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    tools:context=".ProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/header_bg_profile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_header_arredondado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header_layout"
            android:layout_marginBottom="-16dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/btn_voltar_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_seta_profile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/esquerda"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_header_title_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiko_bold"
                android:text="UTILIZADORES"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/search_row_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/header_bg_profile">

            <FrameLayout
                android:id="@+id/search_container_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_search_bar_focused"
                android:addStatesFromChildren="true">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lupa_anim_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/pesquisa" />

                <EditText
                    android:id="@+id/search_bar_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Pesquisar utilizador..."
                    android:textColorHint="@color/texto_dica"
                    android:paddingStart="52dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp"
                    android:inputType="text" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_filtro_profile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_cartao_brilhante"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_filtro_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/filtro"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_profile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            app:layout_constraintTop_toBottomOf="@id/search_row_profile"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_perfis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layoutAnimation="@anim/layout_animation_slide_up" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/ll_empty_state_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="64dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhum utilizador encontrado"
                        android:textColor="@color/texto_dica"
                        android:textSize="14sp"
                        android:fontFamily="@font/amiko_bold"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_perfil_anterior"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="40dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:visibility="gone"
                        android:elevation="2dp">
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_voltar_profile_pag"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleX="-1"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_perfil_proximo"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_cartao_brilhante"
                        android:elevation="2dp">
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie_seta_avancar_profile_pag"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:lottie_rawRes="@raw/seta_direita"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_profile"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_bottom_nav"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>