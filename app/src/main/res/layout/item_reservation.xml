<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_cartao_brilhante"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_res_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/amiko_bold"
        android:text="Webcam 1"
        android:textColor="@color/azul_glpi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        app:layout_constraintEnd_toStartOf="@id/tv_res_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_res_item_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Peripheral"
        android:textColor="@color/texto_dica"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tv_res_status"
        app:layout_constraintStart_toStartOf="@id/tv_res_item_name"
        app:layout_constraintTop_toBottomOf="@id/tv_res_item_name" />

    <TextView
        android:id="@+id/tv_res_status"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_estado"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="LIVRE"
        android:textColor="@color/branco"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_res_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Próxima reserva: 19/03/2026"
        android:textColor="@color/texto_dica"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_res_item_name"
        app:layout_constraintTop_toBottomOf="@id/tv_res_item_type" />

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_res_item_name"
        app:layout_constraintTop_toBottomOf="@id/tv_res_details">

        <Button
            android:id="@+id/btn_res_detalhes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/fundo_filtro_inativo"
            android:text="VER INFO"
            android:textColor="@color/texto_principal"
            android:textSize="9sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btn_reservar_acao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/azul_glpi"
            android:text="EFETUAR RESERVA"
            android:textColor="@color/branco"
            android:textSize="9sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
