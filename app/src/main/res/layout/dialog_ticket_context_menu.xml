<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_history">

    <TextView
        android:id="@+id/tv_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPÇÕES DO TICKET"
        android:textColor="@color/texto_principal"
        android:textSize="13sp"
        android:fontFamily="@font/amiko_bold"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_menu_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_menu_title">

        <!-- Opção: Responder -->
        <LinearLayout
            android:id="@+id/btn_menu_responder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_button_white_oval"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPONDER"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold" />
        </LinearLayout>



        <!-- Opção: Editar -->
        <LinearLayout
            android:id="@+id/btn_menu_editar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_button_white_oval"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDITAR"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Opção: Reciclagem -->
        <LinearLayout
            android:id="@+id/btn_menu_reciclagem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_button_white_oval"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENVIAR PARA A RECICLAGEM"
                android:textColor="@color/vermelho_forte"
                android:textSize="14sp"
                android:fontFamily="@font/amiko_bold"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
