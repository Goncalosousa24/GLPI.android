<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Linha da Timeline (Parte Superior) -->
    <View
        android:id="@+id/view_timeline_top"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/azul_glpi"
        android:alpha="0.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iv_action_icon"
        app:layout_constraintStart_toStartOf="@id/iv_action_icon"
        app:layout_constraintEnd_toEndOf="@id/iv_action_icon" />

    <ImageView
        android:id="@+id/iv_action_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_circulo_azul"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="4dp" />

    <!-- Linha da Timeline (Parte Inferior) -->
    <View
        android:id="@+id/view_timeline_bottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/azul_glpi"
        android:alpha="0.3"
        app:layout_constraintTop_toBottomOf="@id/iv_action_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/iv_action_icon"
        app:layout_constraintEnd_toEndOf="@id/iv_action_icon" />

    <!-- Card de Conteúdo -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintStart_toEndOf="@id/iv_action_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_action_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ação Registada"
                android:textColor="#2C3E50"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_action_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detalhes da ação no GLPI"
                android:textColor="#7F8C8D"
                android:lineHeight="18sp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_action_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="end"
                android:text="agora"
                android:textColor="@color/texto_dica"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
