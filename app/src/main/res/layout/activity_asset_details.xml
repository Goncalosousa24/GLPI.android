<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/header_bg_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_header_arredondado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header_layout"
            android:layout_marginBottom="-16dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/btn_voltar_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_seta_details"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/esquerda" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_asset_name_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="60dp"
                android:ellipsize="end"
                android:fontFamily="@font/amiko_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="NOME DO EQUIPAMENTO"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/container_info_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/header_bg_details">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_asset_type_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIPO: COMPUTER"
                    android:textColor="@color/azul_glpi"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_asset_id_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID GLPI: #1234"
                    android:textColor="@color/texto_dica"
                    android:textSize="12sp" />
            </LinearLayout>


        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/container_info_asset"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nested_scroll_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="40dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="200dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_asset_history"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="12dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:layoutAnimation="@anim/layout_animation_slide_up" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_asset_ports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="12dp"
                            android:clipToPadding="false"
                            android:visibility="gone"
                            android:nestedScrollingEnabled="false"
                            android:layoutAnimation="@anim/layout_animation_slide_up" />
                    </FrameLayout>

                    <!-- Paginação centrada -->
                    <LinearLayout
                        android:id="@+id/layout_paginacao_detalhes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="32dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_prev_detalhes"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="40dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_prev_detalhes"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:scaleX="-1"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:lottie_colorFilter="@color/azul_glpi"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_next_detalhes"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="40dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:clickable="true"
                            android:focusable="true">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_next_detalhes"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:lottie_colorFilter="@color/azul_glpi"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/ll_vazio_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_vazio_details"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_rawRes="@raw/vazio"
                app:lottie_colorFilter="@color/azul_glpi"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />

            <TextView
                android:id="@+id/tv_vazio_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum registo encontrado"
                android:textColor="@color/texto_dica"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/progress_details"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:visibility="gone"
            app:lottie_rawRes="@raw/carregar"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
