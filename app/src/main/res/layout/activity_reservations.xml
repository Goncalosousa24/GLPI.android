<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_res"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo_app">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/header_bg_res"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_header_arredondado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/header_layout"
                android:layout_marginBottom="-16dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/btn_voltar_res"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_seta_res"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/esquerda"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_bold"
                    android:text="RESERVAS"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/search_row_res"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/header_bg_res">
                <FrameLayout
                    android:id="@+id/search_container_res"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar_focused"
                    android:addStatesFromChildren="true">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_lupa_res"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        app:lottie_rawRes="@raw/pesquisa"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                    <EditText
                        android:id="@+id/search_bar_res"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Pesquisar..."
                        android:textColorHint="@color/texto_dica"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:inputType="text" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_ordem_res"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_cartao_brilhante"
                    android:clickable="true"
                    android:focusable="true">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_ordem_res"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/filtro"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_chips_res"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/search_row_res">

                <TextView
                    android:id="@+id/chip_res_todos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_chip_filtros"
                    android:textColor="@color/selector_texto_chip"
                    android:gravity="center"
                    android:text="TODOS"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_res_computadores"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/selector_chip_filtros"
                    android:textColor="@color/selector_texto_chip"
                    android:gravity="center"
                    android:text="COMPUTADORES"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_res_perifericos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/selector_chip_filtros"
                    android:textColor="@color/selector_texto_chip"
                    android:gravity="center"
                    android:text="PERIFÉRICOS"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nested_scroll_res"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/container_chips_res"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_reservations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingBottom="16dp"
                        android:layoutAnimation="@anim/layout_animation_slide_up" />

                    <!-- Paginação (Estilo Padrão) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/container_paginacao_res"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="32dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_pagina_anterior_res"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_proxima_pagina_res">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_voltar_res"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:scaleX="-1"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_proxima_pagina_res"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="100dp"
                            android:background="@drawable/bg_cartao_brilhante"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_goneMarginStart="0dp"
                            app:layout_constraintStart_toEndOf="@+id/btn_pagina_anterior_res"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/seta_avancar_res"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:lottie_rawRes="@raw/seta_direita"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="false"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/progress_res"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="gone"
        app:lottie_rawRes="@raw/carregar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include 
        layout="@layout/layout_custom_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
